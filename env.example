# --- Source 1 : La Bonne Alternance ---
# Token : https://api.apprentissage.beta.gouv.fr/fr/compte/profil
LBA_API_TOKEN=

# Codes ROME — panel BUT informatique (dev, infra, SI) :
# M1805 = Études et développement informatique (dev web/mobile/logiciel)
# M1802 = Expertise et support en systèmes d'information
# M1801 = Administration de systèmes d'information
# M1810 = Production et exploitation de systèmes d'information
# M1806 = Conseil et maîtrise d'ouvrage en SI
ROME_CODES=M1805,M1802,M1801,M1810,M1806

# --- Source 2 : Adzuna ---
# Clés gratuites : https://developer.adzuna.com/signup
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Source 3 : Jooble ---
# Clé gratuite : https://jooble.org/api/about
JOOBLE_API_KEY=

# --- Discord ---
DISCORD_WEBHOOK_URL=

# --- Critères communs à toutes les sources ---
CITY=Caen
LATITUDE=49.2667
LONGITUDE=-0.4500
RADIUS_KM=40
SEARCH_KEYWORDS=alternance informatique développeur développement web mobile données système réseau

# --- Réglages optionnels ---
# Niveau de log : DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Purge les offres "vues" de plus de N jours de seen_offers.db
PURGE_AFTER_DAYS=60
# Au-delà de N nouvelles offres d'un coup, envoie un seul message Discord
# groupé plutôt qu'un ping par offre (évite le flood au premier run)
DIGEST_THRESHOLD=8
# Mode test : n'envoie rien sur Discord, n'écrit rien en base, affiche juste
# dans les logs ce qui aurait été notifié. Pratique pour tester des réglages.
DRY_RUN=false
